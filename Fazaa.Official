<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pemesanan - fazaa.official</title>
    <style>
        :root {
            --primary-navy: #0B192C;
            --accent-blue: #1E3E62;
            --soft-bg: #F5F7FA;
            --card-bg: #FFFFFF;
            --text-main: #333333;
            --text-muted: #666666;
            --wa-green: #25D366;
            --wa-hover: #20BA5A;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--soft-bg);
            margin: 0;
            padding: 0;
            color: var(--text-main);
        }

        .container {
            max-width: 460px;
            margin: 40px auto;
            padding: 20px;
        }

        .card {
            background: var(--card-bg);
            padding: 35px 30px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(11, 25, 44, 0.08);
            text-align: center;
            border-top: 4px solid var(--primary-navy);
        }

        .logo-container {
            margin-bottom: 20px;
        }

        .logo-img {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-navy);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        h1 {
            color: var(--primary-navy);
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 5px 0;
            letter-spacing: 0.5px;
        }

        p.sub {
            color: var(--text-muted);
            font-size: 13px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        label {
            font-weight: 600;
            font-size: 13px;
            display: block;
            margin-bottom: 6px;
            color: var(--primary-navy);
        }

        input, select, textarea {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #D0D7DE;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            background-color: #FAFBFC;
            transition: all 0.3s ease;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--accent-blue);
            background-color: #FFFFFF;
            outline: none;
            box-shadow: 0 0 0 3px rgba(30, 62, 98, 0.1);
        }

        .btn-wa {
            width: 100%;
            background-color: var(--wa-green);
            color: white;
            border: none;
            padding: 13px;
            margin-top: 10px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.1s;
        }

        .btn-wa:hover {
            background-color: var(--wa-hover);
        }

        .btn-wa:active {
            transform: scale(0.98);
        }

        footer {
            text-align: center;
            margin-top: 25px;
            font-size: 12px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

<div class="container">
    <div class="card">
        <div class="logo-container">
            <!-- Ganti link di dalam src="" dengan link gambar logo Anda yang sudah di-upload di GitHub -->
            <img src="Logo Monogram FZ Official Minimalis.png" alt="Logo fazaa.official" class="logo-img">
        </div>
        
        <h1>fazaa.official</h1>
        <p class="sub">Formulir Pemesanan Jasa Desain Profesional</p>
        
        <form onsubmit="kirimWA(event)">
            <div class="form-group">
                <label for="nama">Nama Lengkap / Brand:</label>
                <input type="text" id="nama" placeholder="Masukkan nama Anda" required>
            </div>

            <div class="form-group">
                <label for="layanan">Pilih Layanan Jasa:</label>
                <select id="layanan" required>
                    <option value="" disabled selected>-- Pilih Layanan --</option>
                    <option value="Desain Poster">Desain Poster</option>
                    <option value="Desain Banner">Desain Banner</option>
                    <option value="Desain Barcode / QR Code Custom">Desain Barcode / QR Code Custom</option>
                    <option value="Paket Bundling">Paket Bundling (Hemat)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="catatan">Detail / Catatan Pesanan:</label>
                <textarea id="catatan" rows="4" placeholder="Jelaskan konsep, ukuran, teks, atau referensi warna..."></textarea>
            </div>

            <button type="submit" class="btn-wa">Pesan Sekarang via WhatsApp</button>
        </form>
    </div>
    <footer>
        <p>&copy; 2026 fazaa.official. All Rights Reserved.</p>
    </footer>
</div>

<script>
function kirimWA(event) {
    event.preventDefault();
    
    var nama = document.getElementById('nama').value;
    var layanan = document.getElementById('layanan').value;
    var catatan = document.getElementById('catatan').value;
    var nomorWA = "6283196262914";

    var pesan = "Halo Fazaa Official, saya ingin memesan jasa desain.\n\n" +
                "*Nama/Brand:* " + nama + "\n" +
                "*Pilihan Layanan:* " + layanan + "\n" +
                "*Detail/Catatan:* " + (catatan ? catatan : "-");

    var url = "https://wa.me/" + nomorWA + "?text=" + encodeURIComponent(pesan);
    window.open(url, '_blank');
}
</script>

</body>
</html>
